{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "auth/**/*.ts",
    "config/**/*.ts",
    "geolocation/**/*.ts",
    "observability/**/*.ts",
    "pagination/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
